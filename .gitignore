# Data (never commit large data)
# Viết `data/*` chứ KHÔNG phải `data/`: loại cả thư mục thì git không đi vào bên
# trong, mọi dòng `!data/samples/**` phía dưới sẽ vô hiệu.
data/*
*.db
*.sqlite3

# Bộ model T0.5 dạng ONNX (~89 MB) — commit vào đây là nó nằm trong lịch sử git
# vĩnh viễn. Sinh lại bằng `python scripts/export_clip_onnx.py`, rồi đính vào
# GitHub Release và trỏ CLIP_ASSETS_URL vào đó. Xem ADR-0007.
assets/clip/*.onnx
assets/clip/*.data
assets/clip/*.onnx.data
assets/clip/clip_text_embeddings.json
# Gói nén để đính vào Release — cũng không commit, vì lý do y hệt.
clip-assets.tar.gz

# ...nhưng dữ liệu mẫu PHẢI commit — là một phần của hồ sơ bàn giao
!data/samples/
!data/samples/**

# Logs
logs/
*.log

# Test coverage
htmlcov/
.coverage
coverage.xml

# Cache của công cụ — sinh lại sau mỗi lần chạy, không có giá trị lịch sử
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Tài liệu NỘI BỘ của nhóm, không phải deliverable BTC yêu cầu.
# Bàn giao giữa các phiên làm việc, báo cáo tổng quan, báo cáo mentor: viết cho
# nhóm đọc, có chỗ ghi thẳng điểm yếu của hệ thống. Giữ ở máy, không đẩy lên.
docs/BAN_GIAO_*.md
docs/BAO_CAO_*.md
docs/_noi-bo/

# Sách hướng dẫn của chương trình AI20K, chép vào đây để tra cứu lúc làm.
# Không phải sản phẩm của nhóm nên không đẩy lên repo nhóm.
docs/guide/

# README của template khởi tạo, giữ ở máy để đối chiếu.
README_boilerplate.md

# Trang thiết kế giao diện tải về làm tham khảo — không phải mã của nhóm.
original/

# Hai thư mục mới dựng khung, chưa có nội dung thật.
presentation/
Model_List/

