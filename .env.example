# ============================================
# GreenBin AI (VHR-17) — Environment Variables
# ============================================
# Copy file này thành .env rồi điền giá trị. KHÔNG BAO GIỜ commit .env.

# ---- Nhà cung cấp model vision (tầng T1/T2) ----
# gemini | openai | openrouter | nvidia | local_only
# Đổi provider chỉ cần sửa dòng này, không sửa code.
# Lưu ý: DeepSeek KHÔNG nhận ảnh (chỉ text) nên không dùng được cho T1/T2.
VISION_PROVIDER=gemini

# ---- Provider theo từng tầng (tuỳ chọn) ----
# Để trống = dùng VISION_PROVIDER ở trên cho cả ba tầng.
# Mỗi nguồn miễn phí có một kiểu hạn mức khác nhau, nên trộn lại thì cạn quota
# một chỗ không làm đứng cả sản phẩm (đo 01/08/2026: `gemini-flash-latest` chỉ
# có 20 request/ngày ở free tier — 10 lần chụp ảnh là hết).
# Cấu hình khuyến nghị:
#   T1   → nvidia  (~1.000 credit, gánh phần lớn lưu lượng)
#   T2   → gemini  (quota nhỏ, chỉ tiêu vào ca khó)
#   text → gemini  (bản lite, dùng cho bước sinh hướng dẫn + hỏi bằng chữ)
# Tầng T0 (cache pHash) và T0.5 (CLIP local) không gọi API nên không có ở đây.
VISION_PROVIDER_T1=
VISION_PROVIDER_T2=
VISION_PROVIDER_TEXT=

# ---- Embedding cho RAG ----
# Đi đường RIÊNG, không bám theo tầng text: đo 02/08/2026 thì NVIDIA không trả
# về vector qua endpoint OpenAI-compatible nào, còn `text-embedding-004` của
# Google đã chết — chỉ `gemini-embedding-001` còn chạy.
# Để trống model = lấy mặc định của provider. Provider không có model embedding
# thì RAG tự chạy thuần BM25, không gọi hỏng liên tục.
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=
# gemini-embedding-001 trả 3072 chiều; cắt còn 768 cho kho vector nhẹ đi 4 lần.
EMBEDDING_DIMENSIONS=768
# Tự nhúng kho quy định lúc khởi động máy chủ (bật trên Render, tắt khi dev).
# Ở máy dev chạy tay: python scripts/seed.py --embed
EMBED_KB_ON_START=false
# Trọng số điểm embedding khi trộn với BM25. Quét lại bằng:
#   python eval/run_retrieval_eval.py --quet-trong-so
RAG_VECTOR_WEIGHT=0.35

GEMINI_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
NVIDIA_API_KEY=
GROQ_API_KEY=

# Trần token đầu ra cho một lần phân loại. Model suy luận (qwen3.6, gpt-oss)
# tiêu một phần trần vào khối suy nghĩ nên cần cao hơn model thường.
VISION_MAX_OUTPUT_TOKENS=2000
DEEPSEEK_API_KEY=

# Để trống thì lấy mặc định của provider phụ trách TẦNG ĐÓ
# (xem PROVIDER_DEFAULT_MODELS trong src/config.py).
#   gemini      → gemini-flash-lite-latest / gemini-flash-latest
#                 (KHONG dung gemini-2.5-flash / -2.5-pro: Google da dong voi
#                  key tao moi, goi that tra 404 du van hien trong /models)
#   openai      → gpt-4o-mini / gpt-4o
#   openrouter  → openai/gpt-4o-mini / openai/gpt-4o
#   nvidia      → meta/llama-3.2-11b-vision-instruct / …-90b-…
VISION_MODEL_T1=
VISION_MODEL_T2=
TEXT_MODEL=

# ---- Tầng T0.5: model local chạy offline trên CPU ----
LOCAL_MODEL_ENABLED=true
CLIP_MODEL_NAME=openai/clip-vit-base-patch32
CLIP_ACCEPT_CONFIDENCE=0.82

# Đường chạy tầng T0.5 (ADR-0007):
#   auto  — có bộ ONNX thì dùng, không thì lui về torch. Hợp cho máy dev.
#   onnx  — chỉ bản nén int8 (~89 MB, đo được 185 MB RAM · 56 ms/ảnh).
#           Máy chủ 512 MB dùng cái này.
#   torch — chỉ bản đầy đủ. Giữ để làm mốc đối chiếu khi chạy eval.
CLIP_RUNTIME=auto
CLIP_ONNX_DIR=./assets/clip
# Sinh bộ ONNX: python scripts/export_clip_onnx.py --anh <một ảnh rác>
# Rồi nén hai file trong assets/clip thành .tar.gz, đính vào GitHub Release và
# dán link vào đây. Máy chủ dùng đĩa tạm nên nó tự tải lại sau mỗi lần restart.
CLIP_ASSETS_URL=

# ---- Ngưỡng an toàn và HITL ----
HITL_WEIGHT_THRESHOLD_KG=30
HITL_ITEM_COUNT_THRESHOLD=3
HAZARDOUS_MIN_CONFIDENCE=0.80
PHASH_MAX_DISTANCE=6

# ---- Database ----
# Mặc định: SQLite cho máy dev.
DATABASE_URL=sqlite:///./data/app.db

# Khi deploy lên Supabase (PostgreSQL quản lý sẵn):
#   1. Mở Supabase Dashboard → Project Settings → Database → Connection string.
#   2. Chọn "Session pooler" (cổng 5432), KHÔNG phải "Direct connection" —
#      đường trực tiếp chỉ hỗ trợ IPv6, Render free tier không tới được.
#   3. Dán toàn bộ chuỗi vào đây. Mật khẩu có ký tự đặc biệt phải được
#      URL-encode (vd `a@b` → `a%40b`).
#   4. Thêm `?sslmode=require` nếu chuỗi chưa có — Supabase yêu cầu TLS. Code
#      tự chèn khi thiếu, nhưng ghi rõ ở đây để ai nhìn cũng biết.
# DATABASE_URL=postgresql://postgres.<project>:<mat-khau>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# ---- Ảnh và quyền riêng tư ----
MEDIA_DIR=./data/media
MEDIA_MAX_EDGE_PX=512
MEDIA_RETENTION_DAYS=30
FACE_BLUR_ENABLED=true

# ---- Xác thực (tự làm auth thay Supabase — ADR-0004) ----
JWT_SECRET=doi-chuoi-nay-truoc-khi-deploy
JWT_EXPIRE_MINUTES=720

# ---- App ----
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ---- Kiểm soát chi phí ----
BUDGET_LIMIT_USD=25
LLM_CACHE_DIR=./data/cache
CHROMA_PERSIST_DIR=./data/chroma

# ---- LangSmith (AI Logs — Deliverable #4) ----
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=greenbin-ai
LANGCHAIN_TRACING_V2=true

# ---- Logging ----
LOG_LEVEL=INFO

# ---- AI Hook Logging (BTC cấp) ----
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
AI_LOG_API_KEY=thay-bang-key-rieng-tu-link-moi-cua-BTC
AI_LOG_DIR=.ai-log

# ---- Frontend ----
NEXT_PUBLIC_API_URL=http://localhost:8000
