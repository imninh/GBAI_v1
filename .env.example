# ============================================
# AI20K Project — Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# ---- LLM Configuration ----
OPENAI_API_KEY=sk-your-key-here
# Or use other providers:
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=

# ---- Vision / waste classification ----
# "stub" returns a canned label without calling any model. Local testing only —
# a demo running on "stub" is NOT doing recognition, whatever the screen says.
VISION_PROVIDER=stub
STUB_VISION_LABEL=plastic
STUB_VISION_CONFIDENCE=0.91

# For real classification set VISION_PROVIDER=openai and put a working key in
# OPENAI_API_KEY above. Any OpenAI-compatible endpoint works — only the host and
# the model name change:
#
#   OpenAI            (leave VISION_BASE_URL empty)   VISION_MODEL_NAME=gpt-4o-mini
#   Google AI Studio  VISION_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#                     VISION_MODEL_NAME=gemini-2.5-flash
#   OpenRouter        VISION_BASE_URL=https://openrouter.ai/api/v1
#                     VISION_MODEL_NAME=<a vision-capable model>
#
# Whichever you pick, the model must accept image input.
# VISION_BASE_URL=
# VISION_MODEL_NAME=gpt-4o-mini

# ---- IoT devices ----
# "device_id:key" pairs, comma separated. Simulation value shown; never commit
# a real key.
IOT_DEVICE_KEYS=GBIN-001:sim-test-key

# ---- Database ----
DATABASE_URL=postgresql://user:password@localhost:5432/dbname
# For SQLite (development):
# DATABASE_URL=sqlite:///./data/app.db

# ---- Vector Store ----
CHROMA_PERSIST_DIR=./data/chroma
# Or Pinecone:
# PINECONE_API_KEY=
# PINECONE_ENVIRONMENT=

# ---- App Config ----
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---- LangSmith (AI Logs — Deliverable #4) ----
LANGCHAIN_API_KEY=your-langsmith-key-here
LANGCHAIN_PROJECT=ai20k-agent
LANGCHAIN_TRACING_V2=true

# ---- Logging ----
LOG_LEVEL=INFO

# ---- AI Hook Logging (provided by instructor) ----
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
AI_LOG_API_KEY=f3p1dEOhD_z8qjjtbeCtb2t9ASMEliz-4juZfWe3ZPgCtPZp-LjWthBfeNU8d5dP
AI_LOG_DIR=.ai-log

# ---- Frontend (if separate) ----
# NEXT_PUBLIC_API_URL=http://localhost:8000
